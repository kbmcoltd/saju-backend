# Claude API key (never commit the real value) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random long secret used to sign session/reset JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# Postgres connection string. On Render, deploy via render.yaml (a Blueprint) and
# this is wired automatically from the linked database - you don't need to set it
# by hand there. For local development, point it at any Postgres instance, e.g.
# a free one from Render/Neon/Supabase, or `docker run -p 5432:5432 -e
# POSTGRES_PASSWORD=postgres postgres` and use postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/sajuapp

PORT=3000
